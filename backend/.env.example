# Copy to .env (same folder) and fill in what you want. Everything is optional:
# with nothing set, RizzPad runs on the built-in offline coach.

# --- Free AI: Google Gemini (get a key at https://aistudio.google.com) ---
GEMINI_API_KEY=
# Leave blank to auto-pick a current Flash model (Google renames models often).
GEMINI_MODEL=

# --- Or local & free: Ollama (https://ollama.com), e.g.  ollama pull llama3.2 ---
OLLAMA_MODEL=
OLLAMA_HOST=http://127.0.0.1:11434

# auto = Gemini if a key is set, else Ollama if a model is set, else offline.
PROVIDER=auto

# Public deploy extras
RATE_LIMIT=20
RATE_WINDOW=60
# TRUST_PROXY=1   # only when behind your host's proxy (Render, etc.)
